# PFIP environment configuration
# Copy this to .env (`cp .env.example .env`) and fill in secrets.
# NEVER commit .env to git. .gitignore already excludes it.

# ======================================================================
# CORE INFRA (defaults fine for local dev)
# ======================================================================
POSTGRES_USER=pfip
POSTGRES_PASSWORD=pfip_dev_change_me
POSTGRES_DB=pfip
TIMESCALEDB_PORT=5432

REDIS_PORT=6379

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

PREFECT_PORT=4200
MLFLOW_PORT=5000
OLLAMA_PORT=11434
UPTIME_KUMA_PORT=3001

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ======================================================================
# APP SECRETS
# ======================================================================
# NextAuth single-user JWT secret. Generate with:
#   openssl rand -base64 32
# Or on Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256} | % {[byte]$_}))
NEXTAUTH_SECRET=change_me_to_random_32_bytes_base64

# Single-user login (for the solo-use JWT auth)
PFIP_USER_EMAIL=suresh.sahoo@cbcinc.ai
PFIP_USER_PASSWORD_HASH=  # bcrypt hash; generate via scripts/make_password_hash.py

# ======================================================================
# DATA SOURCE API KEYS (all free-tier; fill in as you enable each)
# ======================================================================
# Crypto — public exchanges don't need keys for OHLCV
# But if you use Binance (restricted in India) private data:
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# On-chain
GLASSNODE_API_KEY=           # free tier
COINGLASS_API_KEY=           # free tier
ETHERSCAN_API_KEY=           # free: https://etherscan.io/apis
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=

# Crypto news
CRYPTOPANIC_API_KEY=         # free tier

# US equities
FINNHUB_API_KEY=             # free: https://finnhub.io
TIINGO_API_KEY=              # free: https://tiingo.com
FMP_API_KEY=                 # free: https://financialmodelingprep.com
ALPACA_API_KEY=              # free paper account (if accessible)
ALPACA_API_SECRET=
POLYGON_API_KEY=              # free tier (EOD/delayed only)
ALPHA_VANTAGE_API_KEY=        # free: 25 req/day

# Macro / FX
FRED_API_KEY=                # free: https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=                 # free: https://www.eia.gov/opendata/register.php

# General news
NEWSAPI_API_KEY=             # free: https://newsapi.org
MARKETAUX_API_KEY=           # free tier

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pfip:v0.1 (by /u/yourhandle)

# Telegram (dedicated account — see ONBOARDING.md)
TELEGRAM_API_ID=             # https://my.telegram.org
TELEGRAM_API_HASH=
TELEGRAM_SESSION_FILE=/app/pfip/ingest/telegram/pfip_session.session
TELEGRAM_BOT_TOKEN=           # for outbound alerts
TELEGRAM_BOT_CHAT_ID=          # your personal chat id

# Bluesky
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Farcaster (Neynar API for easier ingestion)
NEYNAR_API_KEY=

# ======================================================================
# LLM
# ======================================================================
# Local by default (Ollama). Groq only if you want cloud fallback.
GROQ_API_KEY=                # free tier — https://groq.com

# LLM routing preferences (local first, groq fallback)
LLM_DEFAULT_MODEL=mistral:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text
LLM_CLOUD_FALLBACK=groq/llama-3.1-8b-instant

# LangSmith for LLM traces (free tier)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pfip
LANGSMITH_TRACING=true

# ======================================================================
# ERROR TRACKING / OBSERVABILITY
# ======================================================================
SENTRY_DSN=                  # free tier — https://sentry.io

# ======================================================================
# PORTFOLIO / USER-SPECIFIC
# ======================================================================
# Your tax year for India (April to March)
TAX_YEAR_START=2026-04-01
TAX_YEAR_END=2027-03-31
HOME_CURRENCY=INR

# Risk / position sizing defaults (override in portfolio settings UI)
MAX_POSITION_PCT=0.10         # 10% per position cap
DRAWDOWN_HALT_PCT=0.20        # 20% peak-to-trough halts all new signals
DAILY_NEW_POSITIONS_CAP=2

# Paper-trading starting capital (fake money for shadow portfolio)
PAPER_STARTING_CAPITAL_INR=1000000

# ======================================================================
# FEATURE FLAGS
# ======================================================================
FEATURE_ML_SIGNALS=false              # Stage 4+
FEATURE_LIVE_TRADING=false            # Never in v1
FEATURE_SHADOW_PORTFOLIO=true
FEATURE_MORNING_BRIEF=true
FEATURE_TELEGRAM_ALERTS=false         # true once TELEGRAM_BOT_TOKEN set
