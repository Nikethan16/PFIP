# Copy this to e2e/.env.local (gitignored) and fill in your single-user creds.
# These drive the E2E login; nothing is committed.
PFIP_E2E_EMAIL=you@example.com
PFIP_E2E_PASSWORD=your-password

# Optional — target. Defaults to the live VM behind Tailscale Funnel:
# PFIP_E2E_BASE_URL=https://apps.tail1d9a60.ts.net:8443
# ...or point at a local dev stack (run `pnpm dev` + the backend first):
# PFIP_E2E_BASE_URL=http://localhost:3000
